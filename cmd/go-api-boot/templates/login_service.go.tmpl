package services

import (
	"context"

	"{{.ProjectPath}}/db"
	pb "{{.ProjectPath}}/generated/pb"
	"github.com/SaiNageswarS/go-api-boot/auth"
	"github.com/SaiNageswarS/go-api-boot/odm/mongodb"
	"github.com/SaiNageswarS/go-collection-boot/async"
	"google.golang.org/grpc"
	"google.golang.org/grpc/codes"
	"google.golang.org/grpc/metadata"
	"google.golang.org/grpc/status"
)

type LoginService struct {
	pb.UnimplementedLoginServer
	mongo *mongodb.Client
}

func ProvideLoginService(mongo *mongodb.Client) *LoginService {
	return &LoginService{
		mongo: mongo,
	}
}

// removing auth interceptor
func (s *LoginService) AuthFuncOverride(ctx context.Context, fullMethodName string) (context.Context, error) {
	return ctx, nil
}

func (s *LoginService) Login(ctx context.Context, req *pb.LoginRequest) (*pb.StatusResponse, error) {
	loginInfo, err := async.Await(mongodb.CollectionOf[db.LoginModel](s.mongo, req.Tenant).FindByID(ctx, req.Id))
	if err != nil {
		return nil, status.Error(codes.NotFound, "User not found")
	}

	// verify login logic

	jwtToken, err := auth.GetToken(req.Tenant, loginInfo.Id(), "user")
	if err != nil {
		return nil, status.Error(codes.Internal, "Could not issue a token")
	}
	if err := grpc.SetHeader(ctx, metadata.Pairs("authorization", "Bearer "+jwtToken)); err != nil {
		return nil, status.Error(codes.Internal, "Could not send the token")
	}

	return &pb.StatusResponse{
		Status:  200,
		Message: "Login successful",
	}, nil
}
